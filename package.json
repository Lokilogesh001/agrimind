{
  "name": "agrimind",
  "version": "1.2.0",
  "private": true,
  "description": "AgriMind: Multi-Agent Resilient Agricultural Advisory Platform",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "python -m uvicorn api.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node scripts/start.js",
    "start:backend": "python -m uvicorn api.main:app --host 127.0.0.1 --port 8000",
    "start:frontend": "npm --prefix web run start",
    "lint": "npm --prefix web run lint",
    "test": "python -m pytest",
    "test:product": "python scripts/verify_product.py",
    "clean": "node scripts/clean.js",
    "postinstall": "npm --prefix web install"
  },
  "keywords": [
    "agrimind",
    "multi-agent",
    "agriculture",
    "langgraph",
    "fastapi",
    "nextjs",
    "icar"
  ],
  "author": "AgriMind Team",
  "license": "UNLICENSED"
}
