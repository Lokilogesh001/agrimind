# Database Configuration (defaults to local SQLite; supports Supabase/PostgreSQL)
DATABASE_URL=sqlite:///agrimind_local.db

# External Weather & Geocoding APIs (Open-Meteo, free tier requires no key)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# Market Data API (Optional Agmarknet / eNAM endpoint)
AGMARKNET_BASE_URL=

# Machine Learning Disease Vision Model Configuration
# Active default: dinov2_lora (DINOv2-Small Rank-4 LoRA). Rollback baseline: production (MobileNetV3-Large).
DISEASE_MODEL_BACKBONE=dinov2_lora
DISEASE_MODEL_PATH=ml/artifacts/best.pt
DINOV2_LORA_CHECKPOINT_PATH=ml/research/pretrained_benchmark/lora_experiments/checkpoints/dinov2_lora_r4_b4_best.pt

# Security & CORS Whitelist
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Gateway Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Provider Configuration (Multi-Provider Chain: OpenAI -> Grok -> Deterministic Template)
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=grok
LLM_TEMPLATE_FALLBACK=true
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=30

# OpenAI Explanation Layer (Optional; agronomic decision remains authoritative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# xAI Grok Explanation Layer (Optional OpenAI-compatible fallback; https://api.x.ai/v1)
XAI_API_KEY=
XAI_MODEL=grok-2-latest
