# Database Configuration (defaults to local SQLite; supports Supabase/PostgreSQL)
DATABASE_URL=sqlite:///agrimind_local.db

# External Weather & Geocoding APIs (Open-Meteo, free tier requires no key)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# Market Data API (Optional Agmarknet / eNAM endpoint)
AGMARKNET_BASE_URL=

# Machine Learning Vision Model Artifact Path
DISEASE_MODEL_PATH=ml/artifacts/best.pt

# Security & CORS Whitelist
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Gateway Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000

# Multi-Provider LLM Explanation Layer (Optional; leaves decision deterministic)
XAI_API_KEY=
XAI_MODEL=grok-4.6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER_ORDER=xai,groq,gemini
LLM_TIMEOUT_SECONDS=20
LLM_RETRIES=2

